<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Cutback</AssemblyName>
    <Authors>pigeonIabs</Authors>
    <Copyright>Copyright (c) 2026 pigeonIabs</Copyright>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/pigeonIabs/Cutback</RepositoryUrl>
    <Version>1.0.0</Version>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <BeatSaberDir Condition="'$(BeatSaberDir)' == ''">$(MSBuildThisFileDirectory)Game</BeatSaberDir>
    <ManagedDir>$(BeatSaberDir)\Beat Saber_Data\Managed</ManagedDir>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="$(ManagedDir)\*.dll" Exclude="$(ManagedDir)\System*.dll;$(ManagedDir)\mscorlib.dll;$(ManagedDir)\netstandard.dll;$(ManagedDir)\Mono*.dll;$(ManagedDir)\Microsoft*.dll"><Private>false</Private></Reference>
    <Reference Include="$(BeatSaberDir)\Plugins\BeatLeader.dll;$(BeatSaberDir)\Plugins\BSML.dll;$(BeatSaberDir)\Plugins\SiraUtil.dll;$(BeatSaberDir)\Plugins\PracticePlugin.dll"><Private>false</Private></Reference>
    <Reference Include="$(BeatSaberDir)\Libs\0Harmony.dll;$(BeatSaberDir)\Libs\Newtonsoft.Json.dll;$(BeatSaberDir)\Libs\Hive.Versioning.dll"><Private>false</Private></Reference>
    <EmbeddedResource Include="manifest.json" LogicalName="Cutback.manifest.json" />
    <EmbeddedResource Include="Settings.bsml" LogicalName="Cutback.Settings.bsml" />
  </ItemGroup>
  <Target Name="CheckGameVersion" BeforeTargets="ResolveReferences">
    <ReadLinesFromFile File="$(BeatSaberDir)\BeatSaberVersion.txt"><Output TaskParameter="Lines" ItemName="GameVersionLine" /></ReadLinesFromFile>
    <Error Condition="'@(GameVersionLine)' != '1.40.8_7379' And '@(GameVersionLine)' != '1.40.8'" Text="Cutback requires the Steam Beat Saber 1.40.8 assemblies." />
  </Target>
</Project>
